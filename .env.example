# Set environment variables in the shell; this file is a template, not automatically loaded.
WEART_PROVIDER=mock
WEART_PIN=replace-with-a-long-local-passphrase
WEART_DEVICE_TOKEN=replace-with-a-random-32-byte-token
WEART_DEVICE_ID=badge-camera
WEART_ORIGIN=http://127.0.0.1:8765
MODEL_API_KEY=
# Live calls require Standard mode. No Contributor variants permitted.
WEART_MODEL=muse-spark-1.3
# Built-in search has no verified hard query cap. Off until explicitly accepted.
WEART_ALLOW_UNBOUNDED_SEARCH=false
WEART_KILL_SWITCH=false
