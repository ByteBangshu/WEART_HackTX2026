CONFIG_IDF_TARGET="esp32s3"
CONFIG_WEART_PINS_CONFIRMED=y
CONFIG_WEART_CAM_D0=11
CONFIG_WEART_CAM_D1=9
CONFIG_WEART_CAM_D2=8
CONFIG_WEART_CAM_D3=10
CONFIG_WEART_CAM_D4=12
CONFIG_WEART_CAM_D5=18
CONFIG_WEART_CAM_D6=17
CONFIG_WEART_CAM_D7=16
CONFIG_WEART_CAM_XCLK=15
CONFIG_WEART_CAM_PCLK=13
CONFIG_WEART_CAM_VSYNC=6
CONFIG_WEART_CAM_HREF=7
CONFIG_WEART_CAM_SDA=4
CONFIG_WEART_CAM_SCL=5
CONFIG_WEART_CAM_PWDN=-1
CONFIG_WEART_CAM_RESET=-1
CONFIG_WEART_BUTTON=0
CONFIG_WEART_LED_R=-1
CONFIG_WEART_LED_G=-1
CONFIG_WEART_LED_B=-1
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
