    int "Camera D6 GPIO"
    default -1
config WEART_CAM_D7
    int "Camera D7 GPIO"
    default -1
config WEART_CAM_XCLK
    int "Camera XCLK GPIO"
    default -1
config WEART_CAM_PCLK
    int "Camera PCLK GPIO"
